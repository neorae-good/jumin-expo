{
 "L01": [["새벽을 여는 손끝에서,"], ["오늘도 [첫 땀]이 시작됩니다."]],
 "L02": [["이마에 맺힌 [땀 한 방울]은,"], ["우리 마을을 잇는", "[첫 바늘땀]이 되었습니다."]],
 "L03": [["[창원]에서 [의령]까지!", "주민의 손으로 가꾼 하루하루가,"], ["한 조각씩 천 위에 놓입니다."]],
 "L04": [["우리 동네를", "더 살기 좋은 곳으로"], ["만들고 싶은", "[작은 마음] 하나."]],
 "L05": [["그 [마음]이 모여", "마을을 바꿉니다."]],
 "L06": [["골목을 가꾸고,"], ["함께 마주 앉아", "[머리를 맞댄] 시간들."]],
 "L07": [["작은 [조각]들이 모여,"], ["어느새 우리 동네의", "[이야기]가 되었습니다."]],
 "L08": [["함안에서 합천까지."], ["[실 한 가닥]이", "마을과 마을을 잇습니다."]],
 "L09": [["그 안에서 우리는", "서로의 [온기]를 나누며,"], ["마을의 [내일]을", "함께 그려갑니다."]],
 "L10": [["매일 마주하는 깨끗한 골목."], ["이웃의 다정한 인사와", "아이들의 [웃음소리]."]],
 "L11": [["주민 한 사람 한 사람의 실천이", "[한 땀 한 땀] 모여 수놓은,"], ["바로 우리 마을의 [오늘]입니다."]],
 "L12": [["[경남 18개 시군],", "저마다의 조각이"], ["마침내 [하나의 천]으로 이어졌습니다!"]],
 "L13": [["이제, 우리가 함께 지은 꿈을"], ["[더 넓은 하늘]로 펼쳐 올립니다."]],
 "L14": [["주민의 손끝에서 시작된 작은 변화가,"], ["경남을 움직이는", "[커다란 힘]이 됩니다."]],
 "L15": [["주민의 [하나된 힘]으로!"], ["경남이 힘차게 [도약]합니다!"]]
}
